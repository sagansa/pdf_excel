# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Session secret for login (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=
FLASK_ENV=

# External API Configuration
SAGANSA_PRESENCE_API_URL=
SAGANSA_PRESENCE_TOKEN=
SAGANSA_REMAINING_STORAGE_API_URL=
SAGANSA_REMAINING_STORAGE_TOKEN=
SAGANSA_SALES_BY_DATE_API_URL=
SAGANSA_SALES_BY_DATE_TOKEN=
SAGANSA_STOCK_COMPARISON_API_URL=
SAGANSA_STOCK_COMPARISON_TOKEN=

# SMTP for password reset emails. Leave SMTP_HOST empty in dev: reset links
# are written to the server log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=true
# Optional: override the base URL used in reset links (defaults to request origin)
APP_BASE_URL=

# API key for the n8n integration endpoint (sent as X-API-Key header by the
# workflow; empty disables the endpoint — fail closed).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
INTEGRATION_API_KEY=
